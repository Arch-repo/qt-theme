/* SPDX-License-Identifier: GPL-3.0-or-later
 * The installer resolves @ANTO_QT_ASSETS@; all colors and dimensions come from
 * the canonical palette and the shell's application-material.json. */
QWidget { selection-background-color: @accent@; selection-color: @selectedForeground@; }
QWidget:disabled { color: @muted@; }
QPushButton, QToolButton, QLineEdit, QAbstractSpinBox, QComboBox {
 background-color: @surface@; border: 1px solid @border@;
 border-radius: @controlRadius@px; padding: 8px @padding@px; min-height: 22px;
}
QPushButton:hover, QToolButton:hover, QComboBox:hover { background-color: @hoverSurface@; }
QPushButton:pressed, QToolButton:pressed, QPushButton:checked, QToolButton:checked { background-color: @selectedSurface@; }
QPushButton:focus, QToolButton:focus, QLineEdit:focus, QAbstractSpinBox:focus, QComboBox:focus { border-color: @accent@; }
QPushButton:default { background-color: @accent@; color: @selectedForeground@; border-color: @accent@; }
QPushButton:flat, QToolButton:autoRaise { border-color: transparent; background-color: transparent; }
QPushButton:flat:hover, QToolButton:autoRaise:hover { background-color: @hoverSurface@; }
QPushButton:disabled, QToolButton:disabled, QLineEdit:disabled, QAbstractSpinBox:disabled, QComboBox:disabled { color: @muted@; background-color: @surface@; border-color: @border@; }
QPushButton::menu-indicator, QToolButton::menu-indicator { image: url("@ANTO_QT_ASSETS@/down.svg"); width: 12px; height: 12px; subcontrol-position: right center; }
QToolButton::menu-button { width: 22px; border: none; border-left: 1px solid @border@; }
QToolButton::menu-arrow { image: url("@ANTO_QT_ASSETS@/down.svg"); width: 12px; height: 12px; }
QComboBox { padding-right: 34px; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 30px; border: none; }
QComboBox::down-arrow { image: url("@ANTO_QT_ASSETS@/down.svg"); width: 18px; height: 18px; }
QComboBox QAbstractItemView { background-color: @popover@; color: @foreground@; border: 1px solid @border@; padding: 4px; outline: none; }
QAbstractSpinBox { padding-right: 30px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 28px; border: none; background-color: transparent; }
QAbstractSpinBox::up-button { subcontrol-position: top right; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: @hoverSurface@; }
QAbstractSpinBox::up-arrow { image: url("@ANTO_QT_ASSETS@/up.svg"); width: 14px; height: 14px; }
QAbstractSpinBox::down-arrow { image: url("@ANTO_QT_ASSETS@/down.svg"); width: 14px; height: 14px; }
QCheckBox, QRadioButton { spacing: @spacing@px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator {
 width: 20px; height: 20px; background-color: @surface@; border: 1px solid @border@; border-radius: 6px;
}
QRadioButton::indicator { border-radius: 10px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: @accent@; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked, QAbstractItemView::indicator:checked { background-color: @accent@; border-color: @accent@; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { image: url("@ANTO_QT_ASSETS@/check-selected.svg"); }
QCheckBox::indicator:indeterminate { background-color: @selectedSurface@; image: url("@ANTO_QT_ASSETS@/check.svg"); }
QRadioButton::indicator:checked { image: url("@ANTO_QT_ASSETS@/radio.svg"); }
QCheckBox:focus, QRadioButton:focus { color: @accent@; }
QProgressBar { background-color: @border@; border: none; border-radius: 6px; min-height: 12px; color: @foreground@; text-align: center; }
QProgressBar::chunk { background-color: @accent@; border-radius: 6px; }
QSlider::groove:horizontal { height: @meterHeight@px; background-color: @border@; border-radius: 3px; }
QSlider::groove:vertical { width: @meterHeight@px; background-color: @border@; border-radius: 3px; }
QSlider::sub-page:horizontal, QSlider::add-page:vertical { background-color: @accent@; border-radius: 3px; }
QSlider::add-page:horizontal, QSlider::sub-page:vertical { background-color: @border@; border-radius: 3px; }
QSlider::handle:horizontal { width: @thumbSize@px; margin: -6px 0; border-radius: 9px; background-color: @foreground@; border: 1px solid @border@; }
QSlider::handle:vertical { height: @thumbSize@px; margin: 0 -6px; border-radius: 9px; background-color: @foreground@; border: 1px solid @border@; }
QSlider::handle:focus { border-color: @accent@; }
QScrollBar:horizontal { height: 10px; background-color: transparent; margin: 0; border: none; }
QScrollBar:vertical { width: 10px; background-color: transparent; margin: 0; border: none; }
QScrollBar::handle { background-color: @muted@; border-radius: 4px; min-width: 20px; min-height: 20px; }
QScrollBar::handle:hover { background-color: @accent@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: none; background-color: transparent; }
QScrollBar::add-page, QScrollBar::sub-page { background-color: transparent; }
QScrollBar::up-arrow, QScrollBar::down-arrow, QScrollBar::left-arrow, QScrollBar::right-arrow { width: 0; height: 0; }
QAbstractScrollArea { border: 1px solid @border@; border-radius: @controlRadius@px; background-color: @surface@; }
QAbstractScrollArea::corner { background-color: transparent; border: none; }
QAbstractItemView { outline: none; alternate-background-color: @surface@; show-decoration-selected: 1; }
QAbstractItemView::item { padding: 5px; border-radius: 6px; }
QAbstractItemView::item:hover { background-color: @hoverSurface@; }
QAbstractItemView::item:selected { background-color: @accent@; color: @selectedForeground@; }
QHeaderView::section { background-color: @surface@; color: @foreground@; border: none; border-bottom: 1px solid @border@; padding: 8px; }
QHeaderView::up-arrow { image: url("@ANTO_QT_ASSETS@/up.svg"); }
QHeaderView::down-arrow { image: url("@ANTO_QT_ASSETS@/down.svg"); }
QTabWidget::pane { border: 1px solid @border@; border-radius: @controlRadius@px; background-color: @surface@; }
QTabBar::tab { background-color: transparent; color: @foreground@; border: 1px solid transparent; border-radius: @controlRadius@px; padding: 8px @padding@px; margin: 2px; }
QTabBar::tab:hover { background-color: @hoverSurface@; }
QTabBar::tab:selected { background-color: @selectedSurface@; border-color: @accent@; }
QTabBar::tab:disabled { color: @muted@; }
QMenu, QToolTip { background-color: @popover@; color: @foreground@; border: 1px solid @border@; border-radius: @controlRadius@px; padding: 6px; }
QMenu::item { padding: 8px 32px; border-radius: 6px; }
QMenu::item:selected { background-color: @accent@; color: @selectedForeground@; }
QMenu::item:disabled { color: @muted@; }
QMenu::separator { height: 1px; background-color: @border@; margin: 4px 8px; }
QMenu::right-arrow { image: url("@ANTO_QT_ASSETS@/right.svg"); width: 16px; height: 16px; }
QMenu::indicator { width: 18px; height: 18px; }
QMenu::indicator:checked { image: url("@ANTO_QT_ASSETS@/check.svg"); }
QMenu::indicator:checked:selected { image: url("@ANTO_QT_ASSETS@/check-selected.svg"); }
QMenuBar, QToolBar, QStatusBar { background-color: @surface@; color: @foreground@; border: none; }
QMenuBar::item { background-color: transparent; padding: 6px @spacing@px; border-radius: 6px; }
QMenuBar::item:selected { background-color: @selectedSurface@; }
QToolBar { spacing: @spacing@px; padding: 4px; border-bottom: 1px solid @border@; }
QToolBar::separator { background-color: @border@; width: 1px; height: 1px; margin: 4px; }
QGroupBox { background-color: @surface@; border: 1px solid @border@; border-radius: @cardRadius@px; margin-top: 20px; padding: @padding@px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; padding: 0 @padding@px; color: @foreground@; }
QDockWidget::title { background-color: @surface@; color: @foreground@; padding: 8px; }
QSplitter::handle { background-color: @border@; width: 1px; height: 1px; }
QSizeGrip { background-color: transparent; }
